# Linux Docker host networking with ComfyUI on the same host.
HOST=127.0.0.1
STUDIO_WORKERS=[{"id":"comfyui","name":"ComfyUI","url":"http://127.0.0.1:8188","capabilities":["image","upscale"]}]

# To allow access from a TLS proxy or an MCP client, set up Studio accounts first.
# STUDIO_ALLOWED_HOSTS=studio.example.com
# STUDIO_MCP_PUBLIC_URL=https://studio.example.com
# STUDIO_MULTI_USER=1
