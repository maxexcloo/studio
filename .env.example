COMFY_URL=http://127.0.0.1:8188
# When COMFY_URL doesn't answer, HEISS looks on 8188 and 8000 and switches to what it finds.
# 0 keeps it on COMFY_URL, e.g. with a second ComfyUI on this computer it must not take over.
# HEISS_COMFY_SEARCH=0
HOST=127.0.0.1
PORT=8787
HEISS_DATA_DIR=./data
COMFY_OUTPUT_DIR=
# Where finished outputs live: "heiss" (HEISS media, ComfyUI as a worker) or "comfy" (ComfyUI's output folder).
# Defaults to heiss in multi-user mode and comfy otherwise.
# HEISS_OUTPUT_STORAGE=
# HEISS_MEDIA_DIR=
# Shared with the HEISS worker node in ComfyUI (comfyui/heiss_worker).
# HEISS_WORKER_TOKEN=
# A pinned model manifest to verify and restore from (docs/guides/CONFIGURATION.md#model-manifest).
# HEISS_MODEL_MANIFEST=/config/models.json
# Optional accounts (docs/guides/CONFIGURATION.md#multi-user-mode). Off by default.
# HEISS_MULTI_USER=1
# Maximum queued or running jobs per ordinary account (default 2).
# HEISS_ACCOUNT_MAX_OUTSTANDING_JOBS=2
# HEISS_ACCOUNT_COOKIE_NAME=heiss_account
# HEISS_ACCOUNT_COOKIE_SECURE=1
# One-time first-administrator token for deployments nobody can open locally (32+ characters).
# HEISS_SETUP_TOKEN=
# Single sign-on (OpenID Connect, e.g. Pocket ID). The provider proves identity; administrators assign access.
# HEISS_OIDC_ISSUER=https://id.example.com
# HEISS_OIDC_CLIENT_ID=
# HEISS_OIDC_REDIRECT_URI=https://studio.example.com/api/accounts/oidc/callback
# HEISS_OIDC_CLIENT_SECRET=
# HEISS_OIDC_LABEL=Pocket ID
# Inpainting is on by default. Set to 0 to hide it.
# HEISS_ENABLE_INPAINT=0
# Optional encoder override. Grid previews use bundled FFmpeg, then system ffmpeg.
# HEISS_FFMPEG_PATH=
# Size of the ordinary video preview cache in MB (Hidden previews stay in memory).
# HEISS_VIDEO_PREVIEW_CACHE_MB=512
# Model downloads: a Hugging Face token for gated repos (sent to huggingface.co only), a mirror, a proxy.
# HF_TOKEN=
# HF_ENDPOINT=https://hf-mirror.com
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1
# Optional Civitai API token, also managed in Presets & Models > Civitai Access.
# Presets & Models is disabled by default. Enable only on the secondary instance.
# HEISS_ENABLE_PRESETS=1
# CIVITAI_API_TOKEN=
# Optional comma-separated DNS servers for Civitai API, media and downloads only.
# Use your configured Tailscale resolver when the system resolver blocks Civitai.
# CIVITAI_DNS_SERVERS=100.100.100.100
# For read-only or remote model libraries: AI Control's API base URL and token.
# Derive the URL from your AI Control deployment configuration; include /api.
# HEISS_MODEL_DOWNLOAD_URL=
# HEISS_MODEL_DOWNLOAD_TOKEN=
# Other devices (Settings › Connection). Extra names this server answers to,
# comma-separated, e.g. a home DNS name or a tailnet name behind a proxy.
HEISS_ALLOWED_HOSTS=
# How long a signed-in phone or computer stays signed in, in days (1-30).
HEISS_DEVICE_SESSION_DAYS=7
# Optional HTTPS for other devices: a certificate and key you already have,
# e.g. from `tailscale cert`. Settings › Connection writes these too.
HEISS_TLS_CERT=
HEISS_TLS_KEY=
# The HTTPS port (PORT + 1 unless set).
HEISS_HTTPS_PORT=
# Days the gallery trash keeps what "Delete all" moved there (default 30).
HEISS_TRASH_DAYS=30

# Optional ready workflow IDs used for a fresh composer and mode changes.
# HEISS_DEFAULT_IMAGE_PROFILE=custom:my-image-workflow
# HEISS_DEFAULT_VIDEO_PROFILE=custom:my-video-workflow
# Set to 0 to show only imported workflows in the generation catalogue.
# HEISS_ENABLE_BUILTIN_PROFILES=1
