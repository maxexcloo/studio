# See CONFIGURATION.md for ownership, accounts, providers and migration.
# Mount ai read-only for workload metadata and missing-definition seeds; live definitions belong to Studio runtime data.
# STUDIO_CONFIG_DIR=/config
# STUDIO_WORKERS='[{"id":"images","name":"Images","url":"http://worker:8188","capabilities":["image","upscale","models"]}]'
# STUDIO_RUNTIME_AUTOMATIC=0
# Development forces lifecycle control off and uses its own API port and data directory.
# STUDIO_DEV_API_PORT=18787
COMFY_URL=http://127.0.0.1:8188
# Keep the selected endpoint; fallback requires an explicit user choice.
STUDIO_COMFY_SEARCH=0
HOST=127.0.0.1
PORT=8787
STUDIO_DATA_DIR=./data
COMFY_OUTPUT_DIR=
# ComfyUI's input folder, when it isn't beside the output folder.
# COMFY_INPUT_DIR=
# Where finished outputs live: "studio" (Studio media, ComfyUI as a worker) or "comfy" (ComfyUI's output folder); other values stop Studio.
# Defaults to studio in multi-user mode and comfy otherwise.
# STUDIO_OUTPUT_STORAGE=
# STUDIO_MEDIA_DIR=
# Shared with the Studio worker node in ComfyUI (worker/comfyui/studio_worker).
# STUDIO_WORKER_TOKEN=
# Model storage stays local by default. Set worker to stream downloads to the library of the worker with the models capability.
# Worker mode requires STUDIO_WORKER_TOKEN on both services and a writable worker models mount.
# STUDIO_MODEL_STORAGE=worker
# A pinned model manifest to verify and restore from (CONFIGURATION.md#model-manifest).
# STUDIO_MODEL_MANIFEST=/config/models.json
# Optional accounts (CONFIGURATION.md#multi-user-mode). Off by default.
# STUDIO_MULTI_USER=1
# Maximum queued or running jobs per ordinary account (default 2).
# STUDIO_ACCOUNT_MAX_OUTSTANDING_JOBS=2
# One-time first-administrator token for deployments nobody can open locally (32+ characters).
# STUDIO_SETUP_TOKEN=
# Single sign-on (OpenID Connect, e.g. Pocket ID). The provider proves identity; administrators assign access.
# STUDIO_OIDC_ISSUER=https://id.example.com
# STUDIO_OIDC_CLIENT_ID=
# STUDIO_OIDC_REDIRECT_URI=https://studio.example.com/api/accounts/oidc/callback
# STUDIO_OIDC_CLIENT_SECRET=
# STUDIO_OIDC_LABEL=Single Sign-On
# Inpainting is on by default. Set to 0 to hide it.
# STUDIO_ENABLE_INPAINT=0
# Optional encoder override. Grid previews use bundled FFmpeg, then system ffmpeg.
# STUDIO_FFMPEG_PATH=
# Size of the video preview cache in MB.
# STUDIO_VIDEO_PREVIEW_CACHE_MB=512
# Model downloads: a Hugging Face token for gated repos (sent to huggingface.co only), a mirror, a proxy.
# HF_TOKEN=
# HF_ENDPOINT=https://hf-mirror.com
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1
# Optional Civitai API token, kept on the server.
# The Image & Model Library (presets and Civitai imports) is off by default. Enable it only on instances that should offer it.
# STUDIO_ENABLE_PRESETS=1
# CIVITAI_API_TOKEN=
# Optional comma-separated DNS servers for Civitai API, media and downloads only.
# Use your configured Tailscale resolver when the system resolver blocks Civitai.
# CIVITAI_DNS_SERVERS=100.100.100.100
# Extra names this server answers to, comma-separated, e.g. a home DNS name
# or a tailnet name behind a proxy.
STUDIO_ALLOWED_HOSTS=
# How long a signed-in browser stays signed in, in days (1-30).
STUDIO_DEVICE_SESSION_DAYS=7
# Optional HTTPS served by Studio itself: a certificate and key you already have,
# e.g. from `tailscale cert`. Behind a proxy that terminates TLS, leave these empty.
STUDIO_TLS_CERT=
STUDIO_TLS_KEY=
# The HTTPS port (PORT + 1 unless set).
STUDIO_HTTPS_PORT=
# Days the gallery trash keeps what "Delete all" moved there (default 30).
STUDIO_TRASH_DAYS=30

# Optional ready workflow IDs used for a fresh composer and mode changes.
# STUDIO_DEFAULT_IMAGE_PROFILE=custom:my-image-workflow
# STUDIO_DEFAULT_VIDEO_PROFILE=custom:my-video-workflow
# Set to 0 to show only imported workflows in the generation catalogue.
# STUDIO_ENABLE_BUILTIN_PROFILES=1

# Direct media provider. Credentials stay server-side; see Configuration › Cloud Models.
# STUDIO_CLIPROXYAPI_URL=https://cliproxy.example.com
# STUDIO_CLIPROXYAPI_KEY=

# Optional conversational Chat gateway; see Configuration for permitted model patterns.
# STUDIO_CHAT_GATEWAY_URL=https://gateway.example.com
# STUDIO_CHAT_GATEWAY_KEY=
# STUDIO_CHAT_GATEWAY_MODELS=ai/*,deepseek/specific
