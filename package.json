{
  "name": "studio",
  "version": "0.43.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxexcloo/studio.git"
  },
  "bugs": {
    "url": "https://github.com/maxexcloo/studio/issues"
  },
  "homepage": "https://github.com/maxexcloo/studio",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "node scripts/dev.mjs",
    "dev:demo": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"node -e \\\"process.env.STUDIO_DEMO='1';import('./server/index.js')\\\"\"",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:setup-demo": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"node scripts/setup-demo.mjs\"",
    "predev": "node scripts/ensure-runtime-dependencies.mjs",
    "predev:demo": "node scripts/ensure-runtime-dependencies.mjs",
    "predev:lan": "node scripts/ensure-runtime-dependencies.mjs",
    "predev:setup-demo": "node scripts/ensure-runtime-dependencies.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "release": "node scripts/release.mjs",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js scripts/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "busboy": "^1.6.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-static-gzip": "^3.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@videojs/react": "^10.0.1",
    "@vitejs/plugin-react": "^5.1.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.0",
    "motion": "^12.38.0",
    "img-fx": "^0.5.1",
    "lucide-react": "^1.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "allowScripts": {
    "esbuild@*": true,
    "ffmpeg-static@*": true
  }
}
