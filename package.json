  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxexcloo/studio.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:lan": "node scripts/dev.mjs --lan",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "release": "node scripts/release.mjs",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js server/rewrite/*.test.ts server/runtime/*.test.ts server/persistence/*.test.ts server/providers/*.test.ts scripts/*.test.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "busboy": "^1.6.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-static-gzip": "^3.0.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@mantine/core": "latest",
    "@mantine/form": "latest",
    "@mantine/hooks": "latest",
    "@mantine/notifications": "latest",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query": "latest",
    "@tanstack/react-virtual": "latest",
    "@types/express": "latest",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react": "^1.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router": "latest",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "allowScripts": {
    "esbuild@*": true,
    "ffmpeg-static@*": true
  }
}
